{
  "name": "ndcms",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev -w @ndc/web",
    "build": "npm run build -w @ndc/web",
    "start": "npm run start -w @ndc/web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "worker": "tsx scripts/worker.ts",
    "db:migrate": "tsx scripts/database.ts migrate",
    "db:backup": "tsx scripts/database.ts backup",
    "admin:create": "tsx scripts/admin.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write apps/web/src packages scripts tests README.md *.json apps/web/*.ts",
    "test:production": "tsx scripts/smoke-production.ts"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/papaparse": "5.5.2",
    "dotenv": "18.0.10",
    "@playwright/test": "1.65.0",
    "prettier": "3.9.10"
  }
}
