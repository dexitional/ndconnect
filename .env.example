APP_URL=http://localhost:3100
DATABASE_PATH=./data/ndcms.sqlite
UPLOAD_DIR=./data/uploads
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=NDC
# Optional registered voice caller ID. Leave blank to omit voice_id from requests.
ARKESEL_VOICE_ID=
ARKESEL_WEBHOOK_SECRET=
MNOTIFY_API_KEY=
# Registered mNotify SMS sender. Phone verification needs OTP approval and app URL.
MNOTIFY_SENDER_ID=NDC
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Explicit local testing only. Never enabled in production.
MOCK_PROVIDER=false
# Enable only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
